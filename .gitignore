# ============================================================================
#  AimCake · .gitignore
# ============================================================================

# Dependencies
node_modules/
.pnpm-store/
.npm/

# Production build artifacts
dist/
dist-ssr/
build/
*.local

# Tauri / Rust artifacts
src-tauri/target/
src-tauri/gen/
**/*.rs.bk

# Environment variables & secrets (CRITICAL: NEVER COMMIT)
.env
.env.local
.env.production
.env.staging
.env.*.local
*.pfx
*.pem
*.key
*.cert
*.crt

# Supabase local environment & temporary data
supabase/.temp/
supabase/functions/.env
supabase/functions/.env.local

# Runtime logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE & Editor caches
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
