# Copia este archivo a .env y completa los valores de tu proyecto Supabase.
# Si se dejan vacíos, la app funciona en "modo local" (solo debug) sin servidor de licencias.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
VITE_AUTH_REDIRECT_URL=xcb://auth/callback
VITE_GOOGLE_AUTH_ENABLED=true
