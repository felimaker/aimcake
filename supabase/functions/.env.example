# ============================================================================
#  Secretos del SERVIDOR (Edge Functions). Nunca se envían al cliente.
#  Local:      supabase functions serve --env-file supabase/functions/.env
#  Producción: supabase secrets set --env-file supabase/functions/.env
#  (SUPABASE_URL, SUPABASE_ANON_KEY y SUPABASE_SERVICE_ROLE_KEY los inyecta
#   Supabase automáticamente en producción.)
# ============================================================================

# Clave privada Ed25519 en hex (genera el par con `pnpm keys`).
LICENSE_PRIVATE_KEY_HEX=

# Stripe → Developers → API keys → Secret key (sk_live_... / sk_test_...)
STRIPE_SECRET_KEY=
# Stripe → Products → precio de la suscripción (price_...)
STRIPE_PRICE_ID=
# Stripe → Developers → Webhooks → Signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=

# Páginas a las que vuelve Stripe Checkout
CHECKOUT_SUCCESS_URL=https://stripe.com/success
CHECKOUT_CANCEL_URL=https://stripe.com/cancel
